# Magnet Forge processing service (FastAPI), built with uv.
#
# IMPORTANT: the build context MUST be the REPO ROOT, not `processing/`.
#
#   docker build -f docker/Dockerfile.processing -t magnet-forge-processing .
#
# `processing` depends on `magnet-forge-format` (format/python) as a local
# `uv` workspace member rather than a published package, so both
# `format/python/` and `processing/` must be present in the build context
# for `uv sync` to resolve the workspace. Building from inside `processing/`
# will fail because `format/python` won't be visible.
#
# Runtime configuration (env vars, no secrets required):
#   PORT          - port uvicorn binds to inside the container (default 8000)
#   FIXTURE_PATH  - overrides the location of the sample project fixture
#                   the /fixture endpoint serves (defaults to the copy
#                   baked into this image at build time; see
#                   processing/src/magnet_forge_processing/fixture_source.py)

FROM python:3.11-slim AS builder

# Pinned, official uv binaries -- avoids installing uv via pip/apt.
COPY --from=ghcr.io/astral-sh/uv:0.5.30 /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Workspace + member manifests first, for layer caching independent of source changes.
COPY pyproject.toml uv.lock ./
COPY format/python/pyproject.toml format/python/pyproject.toml
COPY processing/pyproject.toml processing/pyproject.toml

# Application source for both workspace members. Tests are intentionally
# not copied into the build (or the final image).
COPY format/python/src format/python/src
COPY processing/src processing/src

# The sample project fixture the /fixture endpoint serves at runtime.
COPY format/fixtures format/fixtures

# --frozen: fail rather than silently re-resolving if uv.lock is stale.
# --no-dev: skip pytest/httpx dev dependency groups.
RUN uv sync --frozen --no-dev

FROM python:3.11-slim AS final

RUN useradd --create-home --uid 1000 appuser

WORKDIR /app

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FIXTURE_PATH=/app/format/fixtures/sample_project.json \
    PORT=8000

COPY --from=builder --chown=appuser:appuser /app /app

USER appuser

EXPOSE 8000

CMD ["sh", "-c", "exec uvicorn magnet_forge_processing.main:app --host 0.0.0.0 --port ${PORT}"]
